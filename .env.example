# xHUMANPRO Environment Variables
# Copy to .env and fill in actual values

# Warden (local dev only)
WARDEN_ENV_NAME=xhumanpro
WARDEN_ENV_TYPE=local
WARDEN_WEB_ROOT=/
TRAEFIK_DOMAIN=xhumanpro.test
TRAEFIK_SUBDOMAIN=app

# Database
POSTGRES_DB=xhumanpro
POSTGRES_USER=xhumanpro
POSTGRES_PASSWORD=changeme

# Backend
JWT_SECRET=change-this-to-random-string
ENCRYPTION_KEY=change-this-min-32-chars-random

# Zombie FTP (Trovaprezzi click files)
ZOMBIE_FTP_HOST=
ZOMBIE_FTP_USER=
ZOMBIE_FTP_PASSWORD=
